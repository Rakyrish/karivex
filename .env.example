POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=karivexsolutionsltd.com,www.karivexsolutionsltd.com,industrialchemicals.karivexsolutionsltd.com,www.industrialchemicals.karivexsolutionsltd.com,karivex-backend
CSRF_TRUSTED_ORIGINS=https://karivexsolutionsltd.com,https://www.karivexsolutionsltd.com,https://industrialchemicals.karivexsolutionsltd.com
CORS_ALLOWED_ORIGINS=https://karivexsolutionsltd.com,https://www.karivexsolutionsltd.com,https://industrialchemicals.karivexsolutionsltd.com
REVALIDATE_SECRET=
# Canonical host. The apex is primary; industrialchemicals.* 301s here.
SITE_URL=https://karivexsolutionsltd.com

# Business identity — the ONLY place these live. lib/site.ts (frontend) and
# settings.py (backend) read from here; never hardcode any of this in code.
SITE_NAME=Karivex Solutions Ltd
SITE_SHORT_NAME=Karivex
SITE_TAGLINE=Chemical Division
SITE_LEGAL_NAME=Karivex Solutions Ltd
# Apex brand domain — the `url` claimed by the Organization node in
# lib/schema.ts. Same as SITE_URL today; keep them in sync unless the
# catalogue is ever moved back off the apex onto its own host.
SITE_BRAND_URL=https://karivexsolutionsltd.com
SITE_ALTERNATE_NAMES=Karivex,Karivex Solutions,Karivex Chemicals
SITE_DESCRIPTION=Karivex Solutions Ltd is a trusted, leading supplier of chemicals — bulk distribution, supply chain management and procurement services for the industrial chemicals sector in Kenya.
# Comma-separated authoritative profiles (LinkedIn company page, Google
# Business Profile share URL, registry listing). Populate as soon as they
# exist: this is the strongest single entity-verification signal.
SITE_SAME_AS=
SITE_PHONE=+254700000000
# Optional second sales line. Leave blank and the site renders one number.
SITE_PHONE_ALT=
SITE_WHATSAPP=+254700000000
SITE_EMAIL=sales@karivex.co.ke
SITE_ADDRESS_STREET=Enterprise Road, Industrial Area
SITE_ADDRESS_LOCALITY=Nairobi
SITE_ADDRESS_REGION=Nairobi County
SITE_ADDRESS_POSTAL_CODE=00400
SITE_ADDRESS_COUNTRY=KE
SITE_REGIONS=Kenya,Uganda,Tanzania,Rwanda
SITE_HOURS=Mo-Fr 08:00-17:00, Sa 08:00-13:00
SITE_DELIVERY_NAIROBI=24-hour delivery in Nairobi
SITE_DELIVERY_REGIONAL=2-3 day delivery to Uganda, Tanzania & Rwanda
SITE_CERTIFICATIONS=COA & MSDS with every order
# Cities you actually deliver to, as City:Country. Drives geographic keyword
# generation — only list places you genuinely supply, and only in countries
# present in SITE_REGIONS above (others are ignored).
SITE_DELIVERY_CITIES=Nairobi:Kenya,Mombasa:Kenya,Kisumu:Kenya,Eldoret:Kenya,Nakuru:Kenya,Thika:Kenya,Kampala:Uganda,Dar es Salaam:Tanzania,Kigali:Rwanda

# E-E-A-T signals. ALL BLANK BY DEFAULT AND ONLY RENDERED WHEN SET — these are
# the claims where inventing one does real damage (a certification you do not
# hold, a founding year that contradicts the company register). Fill them in
# only with what you can evidence; leaving them empty simply omits the line.
SITE_FOUNDED_YEAR=
SITE_INDUSTRIES_SERVED=
SITE_QUALITY_STATEMENT=
SITE_COMPLIANCE=

# OpenAI — backend-only, never exposed to the frontend. Blank disables AI
# features gracefully (staff drafting tool + public FAQ chatbot).
OPENAI_API_KEY=
# Keep this on mini. gpt-4o was measured on the product-from-URL path and was
# strictly worse for this use case: it refused outright on 2 of 3 industrial
# chemicals (safety tuning treats "write about this chemical from a source
# page" as disallowed more often), and wrote fewer words on the one it did
# complete. Description length is instead handled by the expansion pass in
# ai_tools.services.generate_product_from_source.
OPENAI_CONTENT_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini

# Cloudinary — product/blog image uploads go straight to Cloudinary's CDN
# when all three are set. Blank falls back to local disk storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend transactional email (quote request notifications) -------------
# Blank RESEND_API_KEY disables sending; the app logs a warning and carries on.
# QUOTE_FROM_EMAIL must be on the domain verified in Resend (the apex — DKIM is
# published at resend._domainkey.karivexsolutionsltd.com).
RESEND_API_KEY=
QUOTE_FROM_EMAIL=Karivex Solutions Ltd <quotes@karivexsolutionsltd.com>
# Comma-separated. Where new quote requests are emailed.
QUOTE_NOTIFY_TO=
# Send the customer a "we got it" acknowledgement as well as notifying staff.
QUOTE_SEND_CUSTOMER_ACK=true
