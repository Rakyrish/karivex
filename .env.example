POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=karivex.co.ke,www.karivex.co.ke,karivex_backend
CSRF_TRUSTED_ORIGINS=https://karivex.co.ke,https://www.karivex.co.ke
CORS_ALLOWED_ORIGINS=https://karivex.co.ke
REVALIDATE_SECRET=
SITE_URL=https://karivex.co.ke

# Business identity — the ONLY place these live. lib/site.ts (frontend) and
# settings.py (backend) read from here; never hardcode any of this in code.
SITE_NAME=Karivex Solutions Ltd
SITE_SHORT_NAME=Karivex
SITE_TAGLINE=Chemical Division
SITE_LEGAL_NAME=Karivex Solutions Ltd
SITE_PHONE=+254700000000
SITE_WHATSAPP=+254700000000
SITE_EMAIL=sales@karivex.co.ke
SITE_ADDRESS_STREET=Enterprise Road, Industrial Area
SITE_ADDRESS_LOCALITY=Nairobi
SITE_ADDRESS_REGION=Nairobi County
SITE_ADDRESS_POSTAL_CODE=00100
SITE_ADDRESS_COUNTRY=KE
SITE_REGIONS=Kenya,Uganda,Tanzania,Rwanda
SITE_HOURS=Mo-Fr 08:00-17:00, Sa 08:00-13:00
SITE_DELIVERY_NAIROBI=24-hour delivery in Nairobi
SITE_DELIVERY_REGIONAL=2-3 day delivery to Uganda, Tanzania & Rwanda
SITE_CERTIFICATIONS=COA & MSDS with every order

# M-Pesa Daraja (milestone 3 — sandbox first, env-switchable base URL)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://karivex.co.ke/api/mpesa/callback/

# OpenAI — backend-only, never exposed to the frontend. Blank disables AI
# features gracefully (staff drafting tool + public FAQ chatbot).
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini

# Cloudinary — product/blog image uploads go straight to Cloudinary's CDN
# when all three are set. Blank falls back to local disk storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
